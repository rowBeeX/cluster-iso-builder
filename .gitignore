# Nix-Build-Ausgaben und Caches
/result
/result-*
/.direnv/

# Generierte Installer-Artefakte. Prüfsummen und Metadaten gehören zur ISO
# und werden ebenfalls nicht committet.
/artifacts/
*.iso
*.iso.sha256
*.img
*.qcow2

# Lokale Credentials und Tool-Zustand
/.codex/
/.env
/local-secrets/
/.vectimus/keys/
/.vectimus/receipts/

# Schlüssel- und Klartext-Muster
*.pem
*.key
id_*
!*.pub
*.dec
*.plain
*.decrypted

# Editor- und Test-Reste
*.log
*.tmp
.DS_Store
